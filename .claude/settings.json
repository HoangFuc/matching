      "Bash(npm install @reduxjs/toolkit react-redux redux-persist)",
      "Bash(npx tsc --noEmit)",
      "Read(//Users/david/Desktop/**)",
      "Bash(ls -la /Users/david/Desktop/doblogis/DobLogis/index.*)",
      "Bash(grep -h \"from ''iconsax-react-nativejs''\" /Users/david/Desktop/matching/src/**/*.tsx)",
      "Bash(yarn add -D react-native-svg-transformer)",
      "Bash(npx yarn add -D react-native-svg-transformer)",
      "Bash(lsof -ti:8081)",

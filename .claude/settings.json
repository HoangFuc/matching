      "Bash(npm install react-native-document-picker)",
      "Bash(npm view react-native-document-picker versions --json)",
      "Bash(npm i @react-native-documents/picker)",
      "Bash(node -e \"const m = require\\(''iconsax-react-nativejs''\\); console.log\\(typeof m.Add\\)\")",
      "Bash(grep -l \"Add\" /Users/david/Desktop/matching/node_modules/iconsax-react-nativejs/dist/*.js)"
    ],
    "additionalDirectories": [
      "/Users/david/Desktop/matching/src/screens/dataRoom/components"
    ]
  },
   "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "true"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $PWD/hooks/query_hook.js",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "jq . > pre-log.json"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | xargs -I {} npx --yes prettier --write {} 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "node $PWD/hooks/tsc.js"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "jq . > post-log.json"
          }
        ]
      }
    ]
  }
}
